{
  "kind": "collectionType",
  "collectionName": "course_categories",
  "info": {
    "singularName": "course-category",
    "pluralName": "course-categories",
    "displayName": "Course Category"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "category_name": {
      "type": "string"
    },
    "recorderd_lectures": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recorderd-lecture.recorderd-lecture",
      "mappedBy": "course_category"
    },
    "webinars": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::webinar.webinar",
      "inversedBy": "course_categories"
    },
    "course_modules": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-module.course-module",
      "mappedBy": "course_category"
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "course_categories"
    }
  }
}
